# .env.example をコピーして .env を作り、値を入れてください。

# Claude API のキー（構成案と動画化メモの作成に使います）
# https://console.anthropic.com/ で発行できます
ANTHROPIC_API_KEY=

# 使う Claude のモデル（通常は変更不要）
CLAUDE_MODEL=claude-sonnet-5-5

# アプリを開くアドレス。Canva のログイン後にここへ戻ってきます。
# ポートを変えた場合はここも合わせてください。
BASE_URL=http://localhost:3000
PORT=3000

# 0.0.0.0 にすると同じネットワークの他のPCからも開けます（初期値はこのPCのみ）
HOST=127.0.0.1

# Canva MCP サーバーのアドレス（通常は変更不要）
CANVA_MCP_URL=https://mcp.canva.com/mcp
